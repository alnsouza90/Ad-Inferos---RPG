[resource]
script = ExtResource("1_evt")
id = &"c02_temptation_wind_shelter"
type = &"temptation"
circle = 2
title_pt = "O abrigo do vento"
origin = &"game_fiction"
pages = [{
"speaker": "narrator",
"text_pt": "O vento do segundo círculo não cessa. Na areia revolvida, os rastros do Peregrino parecem desviar do caminho e entrar numa tenda clara, quieta, como se a tempestade não a tocasse."
}, {
"speaker": "demon_tempter",
"text_pt": "Ele estava cansado de lutar contra o vento. Aqui há calor, perfume e silêncio. Deixai-o descansar. Por que arrancá-lo daqui?"
}, {
"speaker": "narrator",
"text_pt": "De dentro da tenda, nenhum som. Os santos se entreolham."
}]
options = [{
"id": "follow_tracks",
"text_pt": "Seguir os rastros pela tempestade",
"safe": true,
"result_pt": "A companhia dá as costas à tenda. Mais adiante, sob a areia, os rastros verdadeiros do Peregrino seguem contra o vento.",
"success_pt": "",
"failure_pt": "",
"requires": [],
