"on_failure": []
}, {
"id": "enter_tent",
"text_pt": "Entrar na tenda atrás do Peregrino",
"safe": false,
"result_pt": "",
"success_pt": "A tenda está vazia. Era só a voz, imitando os passos dele. A ilusão se desfaz, e os santos reencontram os rastros verdadeiros.",
"failure_pt": "A tenda está vazia, mas o perfume pesa e o tempo escorre. Quando os santos saem, o vento já apagou os rastros; lá adiante, o Peregrino caminha mais só.",
"requires": [],
