[resource]
script = ExtResource("1_evt")
id = &"c02_temptation_wind_shelter"
type = &"temptation"
circle = 2
title_pt = "O abrigo do vento"
origin = &"game_fiction"
pages = [{
"speaker": "narrator",
"text_pt": "O vento do segundo círculo não cessa. Entre as rajadas, a companhia avista uma tenda clara, quieta, como se a tempestade não a tocasse."
}, {
"speaker": "demon_tempter",
"text_pt": "Por que lutar contra o vento? Entrai. Aqui há calor, perfume e silêncio. Ninguém vos cobrará o caminho por uma noite."
}, {
"speaker": "narrator",
"text_pt": "O Peregrino sente o cansaço pesar nos ombros. Os santos aguardam a sua decisão."
}]
options = [{
"id": "refuse",
"text_pt": "Recusar e seguir contra o vento",
"safe": true,
