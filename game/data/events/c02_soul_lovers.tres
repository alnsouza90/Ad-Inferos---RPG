[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://data/defs/event_def.gd" id="1_fjxgg"]

[resource]
script = ExtResource("1_fjxgg")
id = &"c02_soul_lovers"
type = &"soul_meeting"
circle = 2
title_pt = "Os que o vento não separa"
origin = &"game_fiction"
pages = [{
"speaker": "narrator",
"text_pt": "No meio do vento, duas almas não se soltam. O furacão as arrasta juntas, e juntas elas voltam, sempre, ao mesmo lugar."
}, {
"speaker": "soul_lover",
"text_pt": "Vós andais pelo ar escuro e não sois daqui. Se ainda pudéssemos pedir alguma coisa, pediríamos paz para vós, porque tivestes pena de nós."
}, {
"speaker": "soul_lover",
"text_pt": "Líamos juntos um livro, num dia sem cuidado, sobre um amor que não era nosso. Uma página nos venceu. Naquele dia não lemos mais adiante."
}, {
"speaker": "narrator",
"text_pt": "Ele não diz nada. Chora, com o rosto escondido no ombro dela."
}, {
"speaker": "soul_lover",
"text_pt": "Não há dor maior do que lembrar o tempo feliz dentro da miséria. Outro vivo passou por aqui antes de vós. Ouviu nossa história e achou-a bela. Dizei a ele que não é."
}]
options = [{
"chance": {},
"failure_pt": "",
"id": "listen",
"on_failure": [],
"on_success": [],
"outcomes": [{
"amount": 1.0,
"id": "virtue_charity",
