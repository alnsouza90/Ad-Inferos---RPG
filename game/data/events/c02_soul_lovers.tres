}],
"requires": [],
"result_pt": "A alma se cala. O vento as leva de novo, abraçadas. Mais adiante, os rastros do Peregrino se afastam do furacão, como se ele também tivesse ouvido o fim.",
"safe": false,
"success_pt": "",
"text_pt": "Ouvir até o fim"
}, {
"chance": {},
"failure_pt": "",
"id": "follow_tracks",
"on_failure": [],
"on_success": [],
"outcomes": [],
"requires": [],
"result_pt": "Os santos baixam a cabeça e seguem. Atrás deles, o vento retoma as duas almas.",
"safe": false,
"success_pt": "",
"text_pt": "Seguir os rastros sem parar"
}]
