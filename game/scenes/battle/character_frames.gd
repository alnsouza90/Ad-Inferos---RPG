class_name CharacterFrames
extends Resource
## Every animation clip of one character (D-194, T35), generated by
## tools/art/process_frames.py into scenes/battle/combatants/<id>_frames.tres.

@export var character_id: StringName
## Height of the standing figure in the frames, in pixels: the view scales
## the frames so this height fills its figure area.
@export var figure_height: float = 1.0
## Size next to the saints (1: same height). A boss is bigger (D-233).
@export var display_scale: float = 1.0
## How a physical attack reaches the target: &"melee" slides to it,
## &"ranged" hits from where it stands (Vertigo's veils reach far, D-240),
## &"throne"
## only leans (Minos never rises from the throne, D-219).
@export var attack_style: StringName = &"melee"
## How a spiritual attack reaches the target: &"crosses" (exorcism: crosses
## of light orbit the enemy, D-237), &"orb" (a light flies to it),
## &"outline" (the target trembles in a dark light: Vertigo, D-236) or
## &"own" (the clip already shows it: Asmodeus' smoke, D-236).
@export var spell_style: StringName = &"orb"
## The sign of a blessing (D-237, D-238): &"petals" (Teresinha), &"shield"
## (Jorge) or &"ring" (Bento, and the others until their own is chosen).
@export var blessing_style: StringName = &"ring"
## Weight of the blow (D-353, BlowWeight): light, medium, heavy or colossal.
@export var weight: StringName = &"medium"
## Halo behind the head of the idle figure (T36, D-259): centre and
## diameter in pixels of the first idle frame (0: no halo).
@export var halo_center: Vector2 = Vector2.ZERO
@export var halo_diameter: float = 0.0
@export var clips: Array[FrameClip] = []


func clip(clip_id: StringName) -> FrameClip:
	for c: FrameClip in clips:
		if c.id == clip_id:
			return c
	return null


func slides_to_target() -> bool:
	return attack_style == &"melee"


func has_clip(clip_id: StringName) -> bool:
	return clip(clip_id) != null
